# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: Project Settings -> API -> service_role. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The canonical origin. Metadata, the sitemap, robots.txt, auth redirect and
# callback links, payment return URLs and the printed cut list all read it, so
# it is the one place the domain is written down.
#
# Locally:    http://localhost:3000
# Production: https://medosha.net
#
# No trailing slash — siteUrl() strips one, but the value is easier to read
# without it. A preview deployment should NOT carry the production value: a
# canonical tag pointing at the wrong host is worse than none at all, which is
# why this is set per environment rather than compiled in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (wired in Phase 3) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Payments (wired in Phase 6+) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
