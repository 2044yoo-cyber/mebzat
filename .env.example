# --- Supabase (required) ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: Project Settings -> API -> service_role. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# The canonical origin. Metadata, the sitemap, robots.txt, auth redirect and
# callback links, payment return URLs and the printed cut list all read it, so
# it is the one place the domain is written down.
#
# Locally:    http://localhost:3000
# Production: https://medosha.net
#
# No trailing slash — siteUrl() strips one, but the value is easier to read
# without it. A preview deployment should NOT carry the production value: a
# canonical tag pointing at the wrong host is worse than none at all, which is
# why this is set per environment rather than compiled in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps (wired in Phase 3) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Payments (wired in Phase 6+) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Content moderation ---
# Without a provider key nothing is auto-approved: every upload is held for
# review rather than published. That is the safe direction, but it means a
# human has to clear the queue, so set one before opening the site up.
#
# The provider is chosen by name, not hardcoded. Whichever key is present for
# the named provider is used; see src/lib/moderation/provider.ts.
MODERATION_PROVIDER=
OPENAI_MODERATION_KEY=
MODERATION_TEXT_MODEL=
MODERATION_IMAGE_MODEL=

# Where the line falls. A score at or above BLOCK is refused outright; at or
# above REVIEW it is held for a moderator. Anything below is published.
# Defaults are set in provider.ts — override only with a reason.
MODERATION_BLOCK_THRESHOLD=
MODERATION_REVIEW_THRESHOLD=

# How many frames are sampled from an uploaded video before it is judged.
MODERATION_VIDEO_FRAMES=
