From 61a0c1c5be8de127a250694c33b6b6c4ab4057e8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 26 Jul 2026 19:53:46 +0000
Subject: [PATCH 2/4] Allow picsum.photos images so existing seeded rows render

Product/project cards crashed with a next/image runtime error:
  Invalid src prop (https://picsum.photos/...), hostname "picsum.photos"
  is not configured under images in your next.config.js

Rows seeded by an earlier image scheme still carry picsum URLs, so add
the host to remotePatterns rather than reseeding. Unconfigured hosts are
still rejected (verified: example.com -> 400 "url parameter is not allowed").

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Vu9484XGCPFitpwyCgndnD
---
 next.config.ts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/next.config.ts b/next.config.ts
index 73b1933..b289c89 100644
--- a/next.config.ts
+++ b/next.config.ts
@@ -26,6 +26,9 @@ const nextConfig: NextConfig = {
       // dicebear serves generated avatars. See scripts/lib/images.ts.
       { protocol: "https" as const, hostname: "image.pollinations.ai" },
       { protocol: "https" as const, hostname: "api.dicebear.com" },
+      // Earlier seed runs stored picsum URLs; kept so existing seeded rows
+      // still render without reseeding.
+      { protocol: "https" as const, hostname: "picsum.photos" },
     ],
   },
 };
